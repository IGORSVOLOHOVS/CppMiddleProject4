    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch: comments.py loops.py",
            "program": "${workspaceFolder}/build/analyser",
            "args": [
                "-f",
                "${workspaceFolder}/files/comments.py",
                "${workspaceFolder}/files/loops.py"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch: sample.py",
            "program": "${workspaceFolder}/build/analyser",
            "args": [
                "-f",
                "${workspaceFolder}/files/sample.py"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Test: Metric",
            "program": "${workspaceFolder}/build/src/metric_impl/metric_test",
            "args": [],
            "cwd": "${workspaceFolder}/build/src/metric_impl/tests/files"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Test: Metric Accumulator",
            "program": "${workspaceFolder}/build/src/metric_accumulator_impl/metric_accumulator_test",
            "args": [],
            "cwd": "${workspaceFolder}/build/src/metric_accumulator_impl"
        }
    ]
}
